{
  "name": "WadaApp",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "build": {
    "srcDir": ".",
    "includeDir": "include",
    "flags": [
      "-DESP32_PLATFORM",
      "-DUI_LVGL=1",
      "-DHAS_TOUCH_UI=1",
      "-DHAS_TDECK_GT911=1",
      "-DHAS_TDECK_TRACKBALL=1",
      "-DHAS_TDECK_KEYBOARD=1",
      "-DLILYGO_TDECK",
      "-DMAX_CONTACTS=256",
      "-DMAX_GROUP_CHANNELS=8",
      "-DLV_CONF_PATH=lv_conf.h",
      "-DLV_CONF_INCLUDE_SIMPLE=1",
      "-DDISPLAY_ROTATION=0",
      "-DPIN_TB_UP=15",
      "-DPIN_TB_DOWN=3",
      "-DPIN_TB_LEFT=2",
      "-DPIN_TB_RIGHT=1",
      "-DWS_PORT=8765",
      "-Wno-unused-parameter",
      "-Wno-deprecated-declarations",
      "-DPIN_USER_BTN=0",
      "-DPIN_TFT_LEDA_CTL=42",
      "-DPIN_TFT_LEDA_CTL_ACTIVE=1",
      "-DCAP_RADIO_TOOLS=0",
      "-DCAP_USB_FILES=0",
      "-DCAP_WIFI_SETUP=0",
      "-DCAP_BT_SETUP=0",
      "-DCAP_USB_FLASH=0",
      "-DCAP_SCREEN_MIRROR=0",
      "-DCAP_WEB_BROWSER=0",
      "-DCAP_FW_UPDATE_CHECK=0",
      "-DCAP_BUILTIN_LUA_APPS=1",
      "-DCAP_BUILTIN_LANGS=1"
    ],
    "srcFilter": [
      "-<*>",
      "+<port/*.cpp>",
      "+<backend/WebMesh.cpp>",
      "+<vendor/ui-touch/>",
      "-<vendor/ui-touch/BleKeyboard.cpp>",
      "-<vendor/ui-touch/UsbFilesSession.cpp>",
      "+<vendor/LvglPsramAlloc.cpp>",
      "+<vendor/helpers/TouchDiagTrace.cpp>",
      "+<vendor/helpers/ui/UIColorPalette.cpp>",
      "+<vendor/helpers/esp32/TouchPrefsStore.cpp>",
      "+<vendor/helpers/esp32/SdNvsPrefs.cpp>",
      "+<vendor/helpers/input/TDeckTouch.cpp>",
      "+<vendor/helpers/input/TDeckKeyboard.cpp>",
      "+<vendor/helpers/input/TDeckTrackball.cpp>",
      "+<core/*.cpp>",
      "+<core/helpers/*.cpp>",
      "+<ed25519/*.c>",
      "+<lib/lua/src/*.c>",
      "+<vendor/helpers/esp32/WebMirror.cpp>"
    ],
    "extraScript": "build.py"
  },
  "dependencies": {
    "lvgl": "8.4.0",
    "CayenneLPP": "1.6.1",
    "ArduinoJson": "7.4.3",
    "Nanopb": "https://github.com/nanopb/nanopb/archive/0.4.92.zip"
  }
}
